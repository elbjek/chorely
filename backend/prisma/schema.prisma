model Chore {
  id              Int              @id @default(autoincrement())
  name            String
  frequency       Int
  userId          Int
  assignedToId    Int? // The user assigned to the chore
  isCompleted     Boolean          @default(false) @map("is_completed")
  point           Int
  image           String?
  completedById   Int?
  description     String?
  householdChores HouseholdChore[]
  user            User             @relation(fields: [userId], references: [id])
  assignedTo      User?            @relation("AssignedChores", fields: [assignedToId], references: [id])
  completedBy     User?            @relation("CompletedChores", fields: [completedById], references: [id])
  categoryId      Int?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  completeBy      DateTime         @default(now())

  @@map("chore")
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String
  userId Int?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chores Chore[]
}

model Household {
  id                     Int              @id @default(autoincrement())
  name                   String
  householdInvitationURL String?
  isDefaultHousehold     Boolean          @default(false)
  isSetup                Boolean          @default(false)
  householdChores        HouseholdChore[]
  users                  User[]           @relation("UserHouseholds")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @default(now())

  @@map("household")
}

model HouseholdChore {
  householdId Int
  choreId     Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@id([householdId, choreId])
  @@map("household_chore")
}

//one to many user to points

model Point {
  id        Int      @id @default(autoincrement())
  points    Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("point")
}
