generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  password    String? @unique
  name        String?
  image       String?
  householdId Int?

  chores          Chore[]
  points          Point[]
  households      Household[] @relation("UserHouseholds") // Many-to-many relationship
  assignedChores  Chore[]     @relation("AssignedChores")
  completedChores Chore[]     @relation("CompletedChores")
  Category        Category[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now())

  @@map("user")
}

